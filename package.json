{
  "name": "store-assets-generator",
  "version": "1.0.0",
  "description": "Standalone Studio application for Store Assets Generation (screenshots, device frames, and promotional videos)",
  "private": true,
  "type": "module",
  "main": "main.js",
  "build": {
    "appId": "com.storeassets.generator",
    "productName": "Store Assets Generator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "dist/**/*",
      "web/**/*",
      "vendor/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "scripts": {
    "postinstall": "playwright install chromium",
    "build": "tsc",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "test:video": "npm run build && node dist/src/video/render.test.js"
  },
  "dependencies": {
    "@sweetalert2/theme-dark": "^5.0.27",
    "@types/ws": "^8.18.1",
    "archiver": "^7.0.1",
    "fabric": "^7.4.0",
    "moveable": "^0.53.0",
    "playwright": "^1.46.0",
    "qrcode-generator": "^2.0.4",
    "sweetalert2": "^11.26.25",
    "three": "^0.185.1",
    "unzipper": "^0.12.3",
    "ws": "^8.21.3",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/node": "^20.14.9",
    "@types/three": "^0.185.4",
    "@types/unzipper": "^0.10.9",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.2"
  }
}
