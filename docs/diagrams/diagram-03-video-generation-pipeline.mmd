%% Diagram 3 — Video Generation Pipeline (historical, pre-Phase-9 Remotion renderer)
%% Companion to ../ARCHITECTURE.md §6.2 · superseded by Step 4 in diagram-02-four-step-workflow.mmd
flowchart TB
    subgraph IN["Inputs"]
        SS["Screenshots<br/>raw/*.png"]
        BR["Branding<br/>logo + palette"]
        TX["Feature text"]
        MU["Music track"]
    end

    TPL["template.json<br/><i>declarative scene graph</i>"]

    subgraph INTERP["Scene Graph Interpreter"]
        PARSE["Parse + Zod validate"]
        RESOLVE["Resolve slots<br/>{{item}} {{palette.primary}}"]
        EXPAND["Expand repeatFor:<br/>1 scene per screenshot"]
        MAP["Map layers &rarr; Remotion components<br/>animations &rarr; interpolate / spring"]
    end

    subgraph TIMELINE["Composition Timeline"]
        INTRO["Intro scene<br/>logo + app name"]
        F1["Feature scene 1"]
        F2["Feature scene 2"]
        FN["Feature scene N"]
        OUTRO["Outro / CTA"]
    end

    subgraph LAYERS["Layer Primitives"]
        BG["background"]
        DM["device-mockup"]
        TXT["text"]
        LOGO["logo"]
        SHP["shape"]
        CAM["camera"]
        PAN["panoramic"]
    end

    subgraph ANIM["Animatable Properties"]
        A1["translateX / translateY"]
        A2["scale / scaleX / scaleY"]
        A3["rotate3d.x / .y / .z"]
        A4["opacity / blur / flip"]
        A5["camera zoom / pan"]
    end

    subgraph FRAME["Device Frame Compositing"]
        SVG["SVG frame<br/>style + colourway"]
        GEO["geometry.json<br/>inset + radii + cutout"]
        MASK["Mask screenshot<br/>into screen aperture"]
    end

    RENDER["Remotion renderMedia<br/><i>parallel frame workers</i>"]
    FF["FFmpeg<br/>encode + audio mux + fades"]
    CLAMP{"Duration within<br/>platform bounds?"}
    MP4["video/promo.mp4"]
    VAL["Validation<br/>resolution | aspect | codec<br/>duration | audio | black frames"]

    TPL --> PARSE --> RESOLVE --> EXPAND --> MAP
    SS --> RESOLVE
    BR --> RESOLVE
    TX --> RESOLVE

    MAP --> INTRO --> F1 --> F2 --> FN --> OUTRO

    LAYERS -.-> MAP
    ANIM -.-> MAP

    SVG --> MASK
    GEO --> MASK
    SS --> MASK
    MASK --> DM

    OUTRO --> RENDER
    RENDER --> FF
    MU --> FF
    FF --> CLAMP
    CLAMP -->|no| RENDER
    CLAMP -->|yes| MP4
    MP4 --> VAL

    classDef prim fill:#1e3a5f,stroke:#4a9eff,color:#fff
    class BG,DM,TXT,LOGO,SHP,CAM,PAN prim
