%% Companion to ../ARCHITECTURE.md §6.2 · superseded by diagram-02-four-step-workflow.mmd
flowchart LR
    A["App URL"] --> B{"sitemap.xml<br/>available?"}
    B -->|yes| C["Parse sitemap"]
    B -->|no| D["Playwright:<br/>crawl nav / menus / CTAs"]
    C --> E["Rank by prominence<br/>deny-list legal routes"]
    D --> E
    E --> F["Apply config overrides<br/>pin | exclude | reorder"]
    F --> G["ScreenTarget[]"]

    G --> H{"Auth required?"}
    H -->|yes + creds| I["Inject session"]
    H -->|yes, no creds| J["Skip + record reason"]
    H -->|no| K["Public capture"]
    I --> K

    K --> L["Suppress noise<br/>consent | ads | prompts | chat"]
    L --> M["Readiness gate<br/>network idle + content assertion"]
    M --> N{"Blank / error?"}
    N -->|yes| O["Reject &amp; retry"] --> M
    N -->|no| P["raw/*.png @ DPR 3"]

    P --> Q["Derive branding<br/>favicon | og:image | palette"]
    Q --> R["Project Assembly"]
    S["PlatformSpec"] --> R
    T["Template"] --> R
    R --> U["Project Document"]

    U --> V["Still Composition<br/>Remotion renderStill"]
    U --> W["Video Generation<br/>Remotion renderMedia"]
    V --> X["store/*.png"]
    W --> Y["video/promo.mp4"]

    X --> Z["Validation"]
    Y --> Z
    S --> Z
    Z --> AA["report.json<br/>+ versioned package"]

    J -.->|reported| AA
