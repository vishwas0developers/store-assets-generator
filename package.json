{
  "name": "store-assets-generator",
  "version": "1.0.0",
  "description": "AI Agent driven Store Assets Generator (screenshots, device frames, and promotional videos)",
  "type": "module",
  "main": "dist/mcp/server.js",
  "bin": {
    "store-assets": "./dist/cli/index.js"
  },
  "scripts": {
    "postinstall": "playwright install chromium",
    "build": "tsc && node scripts/copy-web-assets.mjs",
    "start": "node dist/cli/index.js ui",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:video": "npm run build && node dist/src/video/render.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "@sweetalert2/theme-dark": "^5.0.27",
    "archiver": "^7.0.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "playwright": "^1.46.0",
    "qrcode-generator": "^2.0.4",
    "sweetalert2": "^11.26.25",
    "three": "^0.185.1",
    "unzipper": "^0.12.3",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/node": "^20.14.9",
    "@types/three": "^0.185.4",
    "@types/unzipper": "^0.10.9",
    "typescript": "^5.5.2"
  }
}
