%% Diagram 2 — Four-Step Manual Workflow (Data Flow) — CURRENT (Phase 9)
%% Companion to ../ARCHITECTURE.md §6.1 · ../IMPLEMENTATION_PLAN.md Phase 9
%% Supersedes diagram-02-legacy-generation-pipeline.mmd.
%% AssetPipeline.run() (src/orchestrator.ts) and PlaywrightFFmpegVideoEngine
%% (src/render/video.ts) are disabled-not-deleted; the four steps below are
%% built from the same underlying discovery/capture/auth/platform-spec modules,
%% now orchestrated through a reviewable Session instead of one opaque call.
flowchart TB
    A["App URL + demo access<br/>(apps/&lt;slug&gt;/auth.json)"] --> B["Step 1 — Capture<br/>DiscoveryEngine.crawl + WebCaptureBackend<br/>(existing auth chain, noise suppression,<br/>HTTP&ge;400 rejection — unchanged)"]
    B --> C["output/&lt;session&gt;/raw/*.png<br/>+ captured-screen count"]

    C --> D["Step 2 — Studio Mockups<br/>mockupHtml(config, screenshot, canvas)<br/>device from config/devices.json catalogue"]
    D --> E["Live preview iframe<br/>(same HTML fn as final render)"]
    E --> F["output/&lt;session&gt;/mockups preview state<br/>(session.json: mockups{})"]

    C --> G["Step 4 — Scene Templates<br/>one scene per raw screenshot"]
    G --> H["sceneHtml(scene) — CSS keyframes<br/>+ window.seek(ms) for deterministic render"]
    H --> I["Scene 1 &rarr; 2 &rarr; 3 preview/edit loop"]
    I --> J["BGM upload"]
    J --> K["ffmpeg frame-step render<br/>+ audio mux (-shortest -c:a aac)"]
    K --> L["output/&lt;session&gt;/video/promo.mp4"]

    F --> M["Step 3 — Store Asset Package<br/>per platform &times; required device classes<br/>(loadPlatformSpec YAML, unchanged)"]
    M --> N["renderMockups at exact store W&times;H<br/>+ min/maxScreenshots warnings"]
    N --> O["MANIFEST.json + archiver zip"]
    O --> P["output/&lt;session&gt;/store-assets.zip<br/>(manual Play Console / App Store Connect upload)"]
