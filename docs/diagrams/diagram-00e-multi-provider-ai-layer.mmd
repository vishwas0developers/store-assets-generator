%% Diagram 0e — Multi-Provider AI Layer
%% Companion to ../ARCHITECTURE.md · ../AI-PROVIDERS.md
flowchart TB
    subgraph REG["Provider Registry &mdash; config/providers.json"]
        P1["openai"]
        P2["openrouter"]
        P3["groq"]
        P4["ollama &mdash; local"]
        P5["lm-studio &mdash; local"]
        P6["anthropic"]
        P7["gemini"]
        PC["+ custom provider<br/><i>id + baseUrl, no code</i>"]
    end

    subgraph ADP["Adapters &mdash; only THREE"]
        A1["openai-compatible<br/><i>one client, base-URL swap</i>"]
        A2["anthropic"]
        A3["gemini"]
    end

    subgraph INV["Model Inventory &mdash; config/models.json"]
        M1["gpt-4o &mdash; vision"]
        M2["claude-sonnet &mdash; vision"]
        M3["gemini-flash &mdash; vision"]
        M4["llama-3.3-70b"]
        M5["llama3.2-vision &mdash; local"]
    end

    DISC["Dynamic Discovery<br/>GET /providers/:id/fetch-models"]
    DERR["missing key &rarr;<br/>{ requiresApiKey, message }<br/><i>actionable, never an exception</i>"]
    CURATE["User curates:<br/>discovery proposes,<br/>user saves + names"]

    subgraph TASKS["Per-Task Bindings"]
        T1["analyze-screen<br/><i>requiresVision</i>"]
        T2["feature-copy"]
        T3["video-title<br/><i>fast + cheap</i>"]
        T4["scene-narrative"]
        T5["review-asset<br/><i>different model =<br/>second opinion</i>"]
        TD["defaultModel<br/><i>null binding falls back here</i>"]
    end

    KEYS["AES-256-GCM key store<br/>env var takes precedence<br/><i>never logged / returned / output</i>"]
    PROMPTS["prompts/ &mdash; editable assets<br/>grounding rule baked in"]

    OUT["Project Document<br/><i>copy persisted as DATA</i>"]
    REND["Deterministic render<br/><i>calls NO API</i>"]
    FB["Failover &rarr; defaultModel<br/><i>substitution recorded</i>"]

    P1 & P2 & P3 & P4 & P5 --> A1
    P6 --> A2
    P7 --> A3
    PC -.-> A1

    A1 & A2 & A3 --> DISC
    DISC --> DERR
    DISC --> CURATE --> INV
    INV --> TASKS
    TD -.-> T4

    KEYS -.-> REG
    PROMPTS -.-> TASKS

    TASKS --> OUT
    TASKS -.->|unavailable| FB --> OUT
    OUT --> REND

    classDef local fill:#1f3d2f,stroke:#4ad48a,color:#fff
    classDef warn fill:#4a1f1f,stroke:#ff6b6b,color:#fff
    class P4,P5,M5 local
    class DERR,FB warn
