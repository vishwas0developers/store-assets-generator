# Store Assets Generator — environment config
#
# Copy this file to .env and fill in your own values — or, preferably,
# don't hand-edit this file at all and use the web UI's Demo Access panel
# instead, which writes these values for you (encrypting the password
# before it ever touches disk). Loaded automatically on every start (CLI,
# MCP server, web UI) by src/config/env.ts. Never commit .env or
# .auth/.secret.key (both are gitignored).
#
# This is what makes demo login "just work" for any captured URL, with no
# apps/<slug>/auth.json needed per target — see
# src/auth/appConfig.ts's loadDefaultAuthConfig(), ported from
# 5.demo-assets-generator/app/config.py's single global config. Frontend/
# target URLs are NOT part of this file — each capture supplies its own
# URL, and the cookie domain is derived from it automatically.

# The admin backend's local dev URL — where /api/demo/status and
# /api/demo/login live. Required for demo login to activate at all.
DEMO_GEN_ADMIN_API_BASE_URL=http://localhost:8000

# Must match the target site's own app code, so the demo session lands in
# the same Application Group the captured pages themselves query.
DEMO_GEN_APP_CODE=

# Demo account email — not a secret, safe to read/edit directly. Must
# match the "Demo Access Email" set on the admin backend's Demo Access
# screen.
DEMO_GEN_DEMO_ACCOUNT_EMAIL=

# AES-256-GCM ciphertext (hex), never plaintext — written automatically by
# the web UI's Demo Access panel (src/auth/credentials.ts: setCredentials).
# Decryptable only together with the local .auth/.secret.key file generated
# alongside it. Do not hand-write a value here — paste the demo account's
# password into the Demo Access panel instead and let the tool encrypt it.
DEMO_GEN_DEMO_ACCOUNT_PASSWORD_ENC=
