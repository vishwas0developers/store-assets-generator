%% Diagram 7 — Capture Sources (Web vs Android)
%% Companion to ../ARCHITECTURE.md §6.1/§6.2 · ../ANDROID-CAPTURE.md
%% Android backend retained in Phase 9 as an alternate Step 1 source, not disabled.
flowchart TB
    AGENT["AI Agent decides per screen"]

    AGENT --> Q{"Can the frontend URL<br/>reproduce this screen<br/>faithfully?"}

    Q -->|yes &mdash; default| WEB
    Q -->|"no: native UI, WebView divergence,<br/>Android-only feature, verification"| AND

    subgraph WEB["Web Backend &mdash; PRIMARY"]
        W1["Playwright Chromium"]
        W2["Device profile<br/>viewport · DPR 3 · UA"]
        W3["Session injection<br/><i>optional demo creds</i>"]
        W4["Noise suppression<br/>consent · ads · prompts"]
        W5["Readiness gate<br/>idle + content assertion"]
        W6["Blank / error reject-retry"]
        W1 --> W2 --> W3 --> W4 --> W5 --> W6
    end

    subgraph AND["Android Backend &mdash; SECONDARY"]
        N0{"Emulator available?"}
        N1["Emulator AVD<br/><i>any resolution</i>"]
        N2["Physical device<br/><i>720x1600 &mdash; verification only</i>"]
        N3["adb install -r &lt;apk&gt;"]
        N4["Deep link<br/>am start -a VIEW -d url"]
        N5["Hygiene: demo status bar,<br/>no notifications, no animations"]
        N6["adb exec-out screencap -p"]
        N7["RESTORE device settings"]
        N0 -->|yes, preferred| N1
        N0 -->|no| N2
        N1 --> N3 --> N4 --> N5 --> N6 --> N7
        N2 --> N3
    end

    IFACE["CaptureSource interface<br/><i>identical output contract</i>"]
    WEB --> IFACE
    AND --> IFACE
    IFACE --> RAW["raw/*.png"]
    RAW --> REST["Project Document &rarr; mockups<br/>&rarr; templates &rarr; video &rarr; validation"]

    NOTE["Resolution is why web is primary:<br/>Playwright captures at any size,<br/>hardware cannot."]
    IFACE -.-> NOTE

    classDef prim fill:#1f3d2f,stroke:#4ad48a,color:#fff
    classDef sec fill:#3d2f1f,stroke:#d4a04a,color:#fff
    classDef warn fill:#4a1f1f,stroke:#ff6b6b,color:#fff
    class W1,W2,W3,W4,W5,W6 prim
    class N1,N3,N4,N5,N6 sec
    class N2,N7 warn
